<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 카카오 SDK 모듈 어디에도 uses-permission 선언이 없어 앱이 직접 넣어야 한다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      음성 인식. 기기 안에서 돌고 오디오는 나가지 않는다. 마이크를 누를 때 묻는다 - 화면을
      열자마자 물으면 글로 적고 나가는 사람에게 이유 없는 권한 창이 뜬다.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      진료 하루 전 알림(#268). Android 13부터 권한이다. 일정을 저장하거나 알림 토글을 켤 때
      묻는다 - 무엇을 알릴지 보이는 순간이어야 거절할지 말지를 판단할 수 있다.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MedicalMateApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedicalMate">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MedicalMate"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              예약 문자 공유(#270). 받은 글로 일정 추가 화면을 채워 연다. 글은 기기 안에서만 읽는다.
              공유 메뉴에는 앱 이름으로 뜬다. 따로 라벨을 달면 사람들이 찾는 "진료메이트"가 보이지 않는다.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
              캘린더 일정 추가 요청(#270). 갤럭시 메시지가 날짜를 알아보면 띄우는 "일정 추가"처럼,
              다른 앱이 캘린더에 일정을 넣어 달라고 할 때 고르는 앱 목록에 뜬다. 보낸 앱이 읽은
              날짜·시각을 그대로 받는다.
            -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>
        </activity>

        <!--
            카카오톡에서 인증을 마치고 앱으로 돌아오는 지점.
            액티비티 자체는 v2-auth AAR에 선언돼 있지만 exported와 intent-filter가 없어
            여기서 같은 이름으로 다시 선언해 병합한다.
            스킴은 kakao{네이티브 앱 키} 형식이며 값은 manifestPlaceholders가 채운다.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="kakao${KAKAO_NATIVE_APP_KEY}" />
            </intent-filter>
        </activity>
    </application>

</manifest>