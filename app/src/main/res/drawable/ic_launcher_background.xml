<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 아이콘 배경. Gradient 심볼의 그라디언트를 108 캔버스로 2.25배 확대했다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="77.1429"
                android:endY="77.1429">
                <item android:offset="0" android:color="#5566D2" />
                <item android:offset="0.55" android:color="#3B4FC0" />
                <item android:offset="1" android:color="#2E3E9E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
