<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Manifest용 테마. UI는 Compose가 그린다.

      windowBackground은 Compose가 첫 프레임을 그리기 전에 보이는 면이다. 앱은 항상
      스플래시(1a-1)로 시작하므로 그 화면과 같은 bg/primary로 맞춘다. bg/canvas로 두면
      회색에서 파란 면으로 한 번 번쩍인다.

      API 31 이상은 values-v31에서 시스템 스플래시까지 같은 면으로 맞춘다.

      다크 모드 값이 없으므로 values-night를 만들지 않는다(DESIGN.md 11.7).
    -->
    <style name="Theme.MedicalMate.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>

    <!-- 실제로 쓰는 이름. API별 차이는 values-v31이 얹는다. -->
    <style name="Theme.MedicalMate" parent="Theme.MedicalMate.Base" />
</resources>
